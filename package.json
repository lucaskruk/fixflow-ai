{
  "name": "fixflow-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wsl": "FIXFLOW_VITE_POLLING=1 vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply fixflow-ai --local",
    "db:reset:local": "wrangler d1 execute fixflow-ai --local --command=\"DROP TABLE IF EXISTS repair_events; DROP TABLE IF EXISTS repairs; DROP TABLE IF EXISTS knowledge_documents; DROP TABLE IF EXISTS d1_migrations;\" && npm run db:migrate:local",
    "db:migrate:remote": "wrangler d1 migrations apply fixflow-ai --remote",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "hono": "^4.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
